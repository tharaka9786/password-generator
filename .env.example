# PassForge Environment Configuration
# Copy this file to .env and customize for your environment:
# cp .env.example .env

# Flask Secret Key for session signing & cookie protection
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Flask Server Configuration
FLASK_DEBUG=False
PORT=5000
HOST=127.0.0.1

# Data Breach Checker (HIBP & Directory) Configuration
BREACH_CHECK_TIMEOUT=5.0
PASSFORGE_USER_AGENT=PassForge-SecuritySuite/2.0 (Breach-Auditor)

# Optional: Have I Been Pwned API Key (not required for k-Anonymity range checks, but supported)
# HIBP_API_KEY=your_hibp_api_key_here
